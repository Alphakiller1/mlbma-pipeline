src/site/
src/site.staging/
public/brand/

# Local speech-to-text binary + model (scripts/lib/whisper.mjs)
.whisper/

# Auto-edit working files (proxies, transcripts) - regenerated from footage/
public/edit/
footage/

# Recording booth build output (scripts/booth.mjs)
booth/dist/

# Local HTTPS cert for the phone-mic page (getUserMedia on LAN)
.cache/

