@@ -104,7 +104,7 @@ def test_bookmaker_env_locks_the_api_request(monkeypatch):
     monkeypatch.setenv("ODDS_BOOKMAKERS", "fanduel")
     monkeypatch.setattr(oddsapi, "remaining", lambda: 100)
 
