{
  "version": 2,
  "note": "Exhaustive per-field classification for the public MLB and NFL artifacts. Every key in a published artifact must resolve to exactly one class here; scripts/validate_public_fields.py fails the build on any key that does not. Classification is by how a number was produced, not by which object it arrived in - teams[].form carries thirteen keys, ten observed and three modelled, and an object-level rule would ship all thirteen.",
  "classes": {
    "provenance": {
      "public": true,
      "note": "Where the file came from and when. Publication time and observation time are different facts and must be able to differ."
    },
    "identity": {
      "public": true,
      "note": "Who and where. Names, codes, person and venue identifiers, broadcast."
    },
    "factual_status": {
      "public": true,
      "note": "What has already happened or is currently true. Score, game state, injury designation, lineup status."
    },
    "descriptive": {
      "public": true,
      "note": "An observed rate or count, or a plain quotient of two of them. As factual as its inputs."
    },
    "derived_descriptive": {
      "public": true,
      "note": "A constructed index or ordering over observed inputs. Public only when published with its formula or its pool, so the reader can see what was chosen. Ranks belong here and must be recomputed from the descriptive value they annotate."
    },
    "contextual_environment": {
      "public": true,
      "note": "Measured conditions around the fixture: ballpark, weather, surface, roof, schedule spacing."
    },
    "model_private": {
      "public": false,
      "note": "A forecast, a price, or a decision. Model Center only. Never rendered on a public page and never present in a payload a public page fetches."
    },
    "model_derived_label": {
      "public": false,
      "note": "A field that looks factual and is not: its value is produced by the model. The failure this class exists to catch is a model ordering published under a descriptive label."
    }
  },
