  "path_overrides": {
    "note": "A leaf name whose class depends on where it sits. Each pattern is matched against the end of the key's path; the first match wins. `rank` is the field this exists for: public only inside a rates object, beside the value it was computed from.",
    "suffixes": {
      ".metrics.*.rank": "derived_descriptive",
      ".parks.*.rank": "derived_descriptive",
      ".rates.*.of": "provenance",
      ".rates.*.rank": "derived_descriptive",
      ".rates[].rank": "derived_descriptive",
      ".windows.*.rank": "derived_descriptive"
    },
    "id_map_note": "Paths whose immediate children are identifiers - a team code, an MLB person id, a normalised player name, a pitch-type code - rather than field names. The classifier descends into their values but does not try to classify the identifier itself: 'aaronjudge' is not a metric, and demanding a class for it would mean re-editing this file every time a club calls somebody up.",
    "id_maps": [
      "$.baselines",
      "$.batters.*",
      "$.bullpen",
      "$.formulas",
      "$.parks",
      "$.pitchers",
      "$.pitchers.*.pitches",
      "$.recent",
      "$.rolling",
      "$.starters",
      "$.teams",
      "$.teams.*"
    ],
    "exact_note": "Whole-path rules, anchored at the artifact root. `note` and `teams` are both named in model_derived_label, where they mean a model's own note and a model's team block. At the root of a published artifact they are the human-readable caveat and the container everything else hangs off, so they resolve by position rather than by name.",
    "exact": {
      "$.note": "provenance",
      "$.teams": "descriptive",
      "$.starters": "descriptive",
      "$.batters": "descriptive",
      "$.bullpen": "descriptive",
      "$.recent": "descriptive",
      "$.rolling": "descriptive",
      "$.parks": "descriptive",
      "$.baselines": "descriptive",
      "$.formulas": "provenance",
      "$.splits": "descriptive",
      "$.pitchers": "descriptive"
    }
  }
